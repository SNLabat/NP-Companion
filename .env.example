# Upstream data source. "reader" = the community Twatter reader API.
SOCIAL_SOURCE=reader
READER_BASE_URL=https://nopixel-twatter-reader.onrender.com/social

# Public site URL (used for canonical links, sitemap, share previews).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=NoPixel Social

# Live badges + "Live in the city" (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional regex for which GTA V stream titles count as NoPixel
# TWITCH_TITLE_FILTER=no\s?pixel|\bnp\b

# Accounts + synced follows/bookmarks (Supabase project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
